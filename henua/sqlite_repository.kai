# henua/sqlite_repository.kai — SQLite adapter for the Repository port.
#
# Imported by user code as `import henua.sqlite_repository`; the
# installer is `sqlite_repository.with_sqlite(c, table, codec, body)`
# and the codec type stays bare (`RepositoryCodec[a, i]`).
#
# `with_sqlite` installs a handler for the `Repository[a, i]` effect
# from `henua/repository_effect.kai`, backed by a table in a
# cell-wrapped SQLite client (`kohau.sqlite.client`). The body talks
# to `Repository.find` / `save` / `delete` exactly as it does under
# `with_in_memory`, so swapping adapters touches only the
# composition root.
#
# ## Why a handler and not a repository value
#
# The client is a `Pid[SqlMsg]` that lives only inside the caller's
# `client.with_client(path, body)` scope, and the compiler rejects a
# function that returns a pid held in a record field. A repository
# value carrying the pid could not be built or threaded, so the pid
# enters as a parameter and stays inside the handler. The row is
# `Actor[SqlMsg]`, never `Ffi`: the cell owns the FFI boundary.
#
# ## Errors
#
# The port's ops do not fail (`find` returns `Option[a]`, `delete` a
# `Bool`). A SQLite failure aborts the body instead: the handler does
# not resume and `with_sqlite` returns `Err(Backend(...))`. A body
# that completes yields `Ok(result)`.
#
# ## Schema
#
#   CREATE TABLE <name> (
#     id   TEXT PRIMARY KEY,
#     data TEXT NOT NULL
#   )
#
# `id` is `codec.id_to_string(i)`. `data` is `codec.to_row(a)` joined
# with the delimiter (`|` by default, `with_sqlite_delim` to pick
# another when the data can contain pipes). The table is created on
# entry if it does not exist.
#
# ## Limitations
#
# - No transactions: every `save` / `delete` is its own statement.
#   Atomicity across operations is the caller's job
#   (`client.exec(c, "BEGIN")` / `"COMMIT"`).
# - The codec must round-trip (`from_row(to_row(x)) == Some(x)`); the
#   adapter does not check it. A row the codec cannot parse reads as
#   absent from `find`.
#
# ## Stability
#
# Every `pub` is `#[unstable]` for the Hanga Roa edition: it tracks
# the `kohau.sqlite.client` surface, itself `#[unstable]`.
#
# ## Security: table-name handling
#
# Bind variables protect every *value* the adapter writes: ids and
# serialised payloads go through positional binds (`BindText`), never
# string concatenation. SQLite does not parameterise *identifiers*,
# so the table name is concatenated into the SQL, and every entry
# point validates it against a strict SQL-identifier subset, failing
# with `Err(Backend("invalid table name: ..."))` before touching the
# database. Accepted shape:
#
#   - First character: ASCII letter (a-z, A-Z) or underscore.
#   - Remaining characters: ASCII letters, digits, or underscores.
#   - Length: 1..64 characters.
#
# **Never feed an unvalidated external string** (HTTP request,
# environment variable, untrusted file) as the table name: the
# validation rejects every injection vector considered, but
# caller-side sanitation stays the first line of defence.

import henua.repository

import henua.repository_effect

import kohau.sqlite.client

# Serialiser bundle. Pure functions only — no effects in the
# closures.
#
# `to_row` / `from_row` MUST round-trip: for every `x`,
# `from_row(to_row(x))` must be `Some(x)`. The adapter does not
# enforce this; codec bugs surface as `Ok(None)` from `find`.
#
# `id_from_string` is allowed to fail (`Option[i]`) because ids come
# back from SQLite as text and a malformed row is not unrecoverable.
pub type RepositoryCodec[a, i] = { to_row: (a) -> [String], from_row: ([String]) -> Option[a], id_to_string: (i) -> String, id_from_string: (String) -> Option[i] }

# Predicate every entry point enforces on the `table` argument. Accepts the strict SQL-identifier subset
# documented in §*Security*: first character is ASCII letter or
# underscore, remaining characters are ASCII letter / digit /
# underscore, length 1..64.
fn is_valid_table_name(s: String) : Bool {
  let n = string_length(s)
  if n < 1 {
    false
  } else if n > 64 {
    false
  } else {
    is_id_head(string_slice(s, 0, 1)) and is_id_tail_from(s, 1, n)
  }
}

fn is_id_head(c: String) : Bool = is_ascii_letter(c) or (c == "_")

fn is_id_tail_from(s: String, i: Int, n: Int) : Bool = if i >= n {
  true
} else {
  let c = string_slice(s, i, 1)
  if (is_ascii_letter(c) or is_ascii_digit(c)) or (c == "_") {
    is_id_tail_from(s, i + 1, n)
  } else {
    false
  }
}

fn is_ascii_letter(c: String) : Bool = ((c >= "a") and (c <= "z")) or ((c >= "A") and (c <= "Z"))

fn is_ascii_digit(c: String) : Bool = (c >= "0") and (c <= "9")

# Join / split helpers — local thin wrappers over the runtime
# `string_concat` / `string_split` primitives, kept local so the
# module's import surface stays minimal.
fn join_with(items: [String], sep: String) : String = match items {
  [] -> ""
  [x] -> x
  [x, ...xs] -> x ++ (sep ++ join_with(xs, sep))
}

fn split_with(s: String, sep: String) : [String] = string_split(s, sep)

# Install a SQLite-backed `Repository[a, i]` handler over `table`
# and run `body` under it. `c` comes from
# `kohau.sqlite.client.with_client(path, ...)`; the adapter uses the
# client but does not own its lifecycle.
#
# Returns `Ok(result)` when `body` completes, `Err(Backend(...))`
# when the table name is invalid, the table cannot be created, or a
# statement fails mid-body (the body does not resume).
#[unstable]
pub fn with_sqlite[a, i, r, e](c: Pid[SqlMsg], table: String, codec: RepositoryCodec[a, i], body: () -> r / Repository[a, i] + e) : Result[r, RepositoryError] / Actor[SqlMsg] + e = with_sqlite_delim(c, table, "|", codec, body)

# `with_sqlite` with a custom delimiter for the `data` column, for a
# codec whose strings can contain pipes.
#[unstable]
pub fn with_sqlite_delim[a, i, r, e](c: Pid[SqlMsg], table: String, delim: String, codec: RepositoryCodec[a, i], body: () -> r / Repository[a, i] + e) : Result[r, RepositoryError] / Actor[SqlMsg] + e = match create_table(c, table) {
  Err(err) -> Err(err)
  Ok(_) -> run_on_table(c, table, delim, codec, body)
}

fn create_table(c: Pid[SqlMsg], table: String) : Result[Unit, RepositoryError] / Actor[SqlMsg] = if not is_valid_table_name(table) {
  Err(Backend("invalid table name: " ++ table))
} else {
  let sql = "CREATE TABLE IF NOT EXISTS " ++ (table ++ " (id TEXT PRIMARY KEY, data TEXT NOT NULL)")
  match client.exec(c, sql, []) {
    Ok(_) -> Ok(())
    Err(err) -> Err(Backend("CREATE TABLE failed: " ++ client.error_to_string(err)))
  }
}

# Values are bound positionally; only the validated table name is
# concatenated into the SQL.
fn run_on_table[a, i, r, e](c: Pid[SqlMsg], table: String, delim: String, codec: RepositoryCodec[a, i], body: () -> r / Repository[a, i] + e) : Result[r, RepositoryError] / Actor[SqlMsg] + e = handle {
  body()
} with Repository[a, i] {
  find(key, resume) -> {
    let sql = "SELECT data FROM " ++ (table ++ " WHERE id = ?")
    match client.query_row(c, sql, [BindText(codec.id_to_string(key))]) {
      Err(err) -> Err(Backend("find failed: " ++ client.error_to_string(err)))
      Ok(None) -> resume(None)
      Ok(Some(cols)) -> resume(codec.from_row(split_with(first_col(cols), delim)))
    }
  }
  save(key, entity, resume) -> {
    let sql = "INSERT OR REPLACE INTO " ++ (table ++ " (id, data) VALUES (?, ?)")
    let binds = [BindText(codec.id_to_string(key)), BindText(join_with(codec.to_row(entity), delim))]
    match client.exec(c, sql, binds) {
      Err(err) -> Err(Backend("save failed: " ++ client.error_to_string(err)))
      Ok(_) -> resume(())
    }
  }
  # The cell's `exec` reply carries the `changes()` count; zero rows
  # changed means the id was not present.
  delete(key, resume) -> {
    let sql = "DELETE FROM " ++ (table ++ " WHERE id = ?")
    match client.exec(c, sql, [BindText(codec.id_to_string(key))]) {
      Err(err) -> Err(Backend("delete failed: " ++ client.error_to_string(err)))
      Ok(changed) -> resume(changed > 0)
    }
  }
  return(x) -> Ok(x)
}

# Extract the single `data` column from a one-column row. The cell
# client's `query_row` returns a `[String]` of length 1 for the
# `SELECT data` shape this adapter issues.
fn first_col(cols: [String]) : String = match cols {
  [] -> ""
  [x, ..._rest] -> x
}

# Number of rows in `table`, through `SELECT COUNT(*)`. Outside the
# port: useful for fixture assertions, not for domain code.
#[unstable]
pub fn size(c: Pid[SqlMsg], table: String) : Result[Int, RepositoryError] / Actor[SqlMsg] = if not is_valid_table_name(table) {
  Err(Backend("invalid table name: " ++ table))
} else {
  match client.query_scalar(c, "SELECT COUNT(*) FROM " ++ table, []) {
    Ok(n) -> Ok(n)
    Err(err) -> Err(Backend("size failed: " ++ client.error_to_string(err)))
  }
}
