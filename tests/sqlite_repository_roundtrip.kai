# tests/sqlite_repository_roundtrip.kai — the SQLite Repository
# adapter against an in-memory database, through the cell-wrapped
# client (`kohau.sqlite.client`).
#
# Coverage:
#   - with_sqlite creates the table and installs the handler
#   - save, then size==1 and find returns the entity
#   - save twice on the same id replaces (size still 1)
#   - delete returns True, then find returns None and size==0
#   - the body's result comes back as Ok
#   - client.close: the cell closes the connection
#
# The domain functions name only `Repository[Todo, Int]`; they would
# run unchanged under `repository_effect.with_in_memory`.
#
# Trace is deterministic: `:memory:` is fresh per run; no timestamps.

import actor

import henua.repository

import henua.repository_effect

import henua.sqlite_repository

import kohau.sqlite.client

type Todo = { title: String, done: Bool }

fn bool_to_string(b: Bool) : String = if b {
  "true"
} else {
  "false"
}

fn string_to_bool(s: String) : Option[Bool] = if s == "true" {
  Some(true)
} else if s == "false" {
  Some(false)
} else {
  None
}

fn todo_to_row(t: Todo) : [String] = [t.title, bool_to_string(t.done)]

fn todo_from_row(r: [String]) : Option[Todo] = match r {
  [title, done_s] -> match string_to_bool(done_s) {
    Some(d) -> Some(Todo { title: title, done: d })
    None -> None
  }
  _ -> None
}

fn id_to_str(i: Int) : String = int_to_string(i)

fn id_from_str(s: String) : Option[Int] = string_to_int(s)

fn print_find(label: String, id: Int) : Unit / Repository[Todo, Int] + Stdout = match Repository.find(id) {
  Some(t) -> Stdout.print(label ++ (" " ++ (t.title ++ (" done=" ++ bool_to_string(t.done)))))
  None -> Stdout.print(label ++ " None")
}

fn print_size(c: Pid[SqlMsg], label: String) : Unit / Stdout + Actor[SqlMsg] = match sqlite_repository.size(c, "todos") {
  Ok(n) -> Stdout.print(label ++ (" size=" ++ int_to_string(n)))
  Err(e) -> Stdout.print(label ++ (" size err=" ++ repository.repository_error_to_string(e)))
}

fn scenario(c: Pid[SqlMsg]) : Int / Repository[Todo, Int] + Stdout + Actor[SqlMsg] {
  print_size(c, "empty")
  Repository.save(1, Todo { title: "buy milk", done: false })
  print_size(c, "after save 1")
  print_find("find 1:", 1)
  Repository.save(1, Todo { title: "buy milk", done: true })
  print_size(c, "after replace")
  print_find("find 1 after replace:", 1)
  Stdout.print("delete 1: " ++ bool_to_string(Repository.delete(1)))
  print_size(c, "after delete")
  print_find("find 1 after delete:", 1)
  42
}

fn body(c: Pid[SqlMsg]) : Unit / Stdout + Actor[SqlMsg] {
  let codec = RepositoryCodec { to_row: todo_to_row, from_row: todo_from_row, id_to_string: id_to_str, id_from_string: id_from_str }
  match sqlite_repository.with_sqlite(c, "todos", codec, () => scenario(c)) {
    Ok(n) -> Stdout.print("result: Ok(" ++ (int_to_string(n) ++ ")"))
    Err(e) -> Stdout.print("result: " ++ repository.repository_error_to_string(e))
  }
  client.close(c)
}

fn main() : Int / Spawn + Ffi + Console {
  with_mailbox(() => {
    client.with_client(":memory:", body)
  })
  0
}
