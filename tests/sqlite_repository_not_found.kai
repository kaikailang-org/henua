# tests/sqlite_repository_not_found.kai — absent ids against the
# SQLite backend: `delete` returns False and `find` returns None.
# Mirrors the in-memory adapter's behaviour in
# `repository_effect_roundtrip.kai`, through the cell-wrapped client.
#
# The body runs in `Actor[SqlMsg]` — no `Ffi`.

import actor

import henua.repository

import henua.repository_effect

import henua.sqlite_repository

import kohau.sqlite.client

# Trivial String aggregate — codec is identity.
fn s_to_row(s: String) : [String] = [s]

fn s_from_row(r: [String]) : Option[String] = match r {
  [x] -> Some(x)
  _ -> None
}

fn id_to_str(i: Int) : String = int_to_string(i)

fn id_from_str(s: String) : Option[Int] = string_to_int(s)

fn yes_no(b: Bool) : String = if b {
  "True"
} else {
  "False"
}

fn scenario() : Unit / Repository[String, Int] + Stdout {
  Stdout.print("delete 7 in empty: " ++ yes_no(Repository.delete(7)))
  match Repository.find(7) {
    Some(s) -> Stdout.print("find 7 in empty: unexpected Some(" ++ (s ++ ")"))
    None -> Stdout.print("find 7 in empty: None")
  }
  Repository.save(1, "alpha")
  Stdout.print("delete 99 after save 1: " ++ yes_no(Repository.delete(99)))
  match Repository.find(1) {
    Some(s) -> Stdout.print("find 1 after failed delete: " ++ s)
    None -> Stdout.print("find 1 after failed delete: unexpected None")
  }
}

fn body(c: Pid[SqlMsg]) : Unit / Stdout + Actor[SqlMsg] {
  let codec = RepositoryCodec { to_row: s_to_row, from_row: s_from_row, id_to_string: id_to_str, id_from_string: id_from_str }
  match sqlite_repository.with_sqlite(c, "items", codec, scenario) {
    Ok(_) -> ()
    Err(e) -> Stdout.print("err=" ++ repository.repository_error_to_string(e))
  }
  client.close(c)
}

fn main() : Int / Spawn + Ffi + Console {
  with_mailbox(() => {
    client.with_client(":memory:", body)
  })
  0
}
