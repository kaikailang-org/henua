# tests/event_bus_unsubscribe.kai — unsubscribe removes a single
# handler; later handlers shift down by one. Removing the last
# handler works, and an out-of-range index is a no-op.

import henua.event_bus

pub type Ev
  = Tick
  | Tock

pub fn a(_ev: Ev) : Unit / Stdout = Stdout.print("A fires")

pub fn b(_ev: Ev) : Unit / Stdout = Stdout.print("B fires")

pub fn c(_ev: Ev) : Unit / Stdout = Stdout.print("C fires")

fn main() : Int / Stdout {
  let bus0: InMemoryEventBus[Ev, Stdout] = event_bus.make_in_memory()
  let s1 = event_bus.subscribe(bus0, a)
  let s2 = event_bus.subscribe(s1.fst, b)
  let s3 = event_bus.subscribe(s2.fst, c)
  let bus_full = s3.fst
  Stdout.print("--- before unsub ---")
  event_bus.publish(bus_full, Tick)
  # Drop B (index 1).
  let bus_after = event_bus.unsubscribe(bus_full, s2.snd)
  Stdout.print("after unsub count=" ++ int_to_string(event_bus.subscriber_count(bus_after)))
  Stdout.print("--- after unsub ---")
  event_bus.publish(bus_after, Tick)
  # Drop the last handler (C, now index 1).
  let bus_tail = event_bus.unsubscribe(bus_after, 1)
  Stdout.print("--- after unsub last ---")
  event_bus.publish(bus_tail, Tick)
  # An out-of-range index leaves the bus unchanged.
  let bus_same = event_bus.unsubscribe(bus_full, 3)
  Stdout.print("out-of-range count=" ++ int_to_string(event_bus.subscriber_count(bus_same)))
  Stdout.print("--- after out-of-range unsub ---")
  event_bus.publish(bus_same, Tick)
  0
}
